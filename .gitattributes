* text=auto eol=lf

*.c            text eol=lf
*.h            text eol=lf
*.rs           text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.toml         text eol=lf
*.json         text eol=lf
*.lock         text eol=lf
*.ps1          text eol=crlf
*.cmd          text eol=crlf
