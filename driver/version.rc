            VALUE "CompanyName", "STEiGER / STGR"
            VALUE "FileDescription", "STGR EXT4 filesystem driver"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "STGRExt4.sys"
            VALUE "LegalCopyright", "Copyright (c) 2026 STEiGER / STGR contributors"
            VALUE "OriginalFilename", "STGRExt4.sys"
            VALUE "ProductName", "STGR EXT4"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
