<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK/SDK content for the hosted Windows runner.

  windows-2025 provides Visual Studio 2022 with the "Windows Driver Kit
  Visual Studio Extension" (the platform toolset), but not the standalone
  WDK content. Microsoft's supported CI approach is to restore the WDK,
  Windows SDK and MSVC runtime content from NuGet. Versions are pinned so
  that a runner image change cannot silently change the compiler inputs.

  Update all three versions together, then update docs/GITHUB-ACTIONS.md
  and Directory.Build.props.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.26100.6584" targetFramework="native" />
</packages>
