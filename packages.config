<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK/SDK content for the hosted Windows driver runner.

  Driver builds run on windows-2022 (Visual Studio 2022, 17.x): the
  10.0.26100 WDK NuGet package ships 17.0 MSBuild task assemblies. The
  windows-2025 label now resolves to Visual Studio 2026 (18.x), whose
  MSBuild looks for an 18.0 assembly and fails with MSB4062. Rust and
  hygiene jobs do not use the WDK and stay on windows-2025.

  Microsoft's supported CI approach is to restore the WDK, Windows SDK and
  MSVC runtime content from NuGet. Versions are pinned so that a runner
  image change cannot silently change the compiler inputs.

  Update all three versions together, then update docs/GITHUB-ACTIONS.md
  and Directory.Build.props.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.26100.6584" targetFramework="native" />
</packages>
